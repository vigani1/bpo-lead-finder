# Search: "tavily" (default; runs keyless with small caps if no key) or "fixture" (offline sample results).
SEARCH_PROVIDER=tavily
# Free key from https://app.tavily.com (1,000 credits/month, no card).
TAVILY_API_KEY=
# Optional: hosted Postgres (Neon). When set, it's used instead of the local PGlite database.
# `neon env pull` writes both: the pooled URL for the app, the direct one for `pnpm db:migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Local Postgres (PGlite) data directory.
DATABASE_DIR=.data/pglite
# Salt for hashing visitor IPs (rate limiting). Change it in production.
IP_HASH_SALT=change-me
# Shown in the crawler's User-Agent so site owners can reach us.
CONTACT_URL=https://github.com/vigani1/bpo-lead-finder
# Optional second search index (https://dashboard.exa.ai). Free $10 credit/month.
EXA_API_KEY=
# AI: any OpenAI-compatible model API (OpenCode Go, Groq, OpenRouter, Anthropic or Gemini compatibility endpoints, local Ollama).
# Without these, pages are read with keyword rules.
# OpenCode Go: AI_BASE_URL=https://opencode.ai/inference/go/openai/v1  AI_MODEL=deepseek-v4.1-flash  AI_JSON_MODE=object  AI_REASONING_EFFORT=low
# Groq (free tier): AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=openai/gpt-oss-120b  AI_TOKENS_PER_MINUTE=8000
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Tokens-per-minute limit to pace calls (Groq free tier: 8000)
AI_TOKENS_PER_MINUTE=
# For reasoning models (gpt-oss, DeepSeek): low | medium | high
AI_REASONING_EFFORT=
# schema (strict JSON-schema output, default) | object (plain JSON mode, for models without schema support such as DeepSeek)
AI_JSON_MODE=
