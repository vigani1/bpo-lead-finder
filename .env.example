# Search: "tavily" (default; runs keyless with small caps if no key) or "fixture" (offline sample results).
SEARCH_PROVIDER=tavily
# Free key from https://app.tavily.com (1,000 credits/month, no card).
TAVILY_API_KEY=
# Optional: hosted Postgres (e.g. Neon). When set, it's used instead of the local PGlite database.
DATABASE_URL=
# Local Postgres (PGlite) data directory.
DATABASE_DIR=.data/pglite
# Salt for hashing visitor IPs (rate limiting). Change it in production.
IP_HASH_SALT=change-me
# Shown in the crawler's User-Agent so site owners can reach us.
CONTACT_URL=https://github.com/vigani1/bpo-lead-finder
# Optional second search index (https://dashboard.exa.ai). Free $10 credit/month.
EXA_API_KEY=
